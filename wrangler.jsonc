{
  "name": "radian-website",
  "main": "worker.js",
  "compatibility_date": "2026-08-13",

  "observability": {
    "enabled": true
  },

  "assets": {
    "directory": "./website",
    "binding": "WEBSITE",
    "not_found_handling": "single-page-application"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "radian-db",
      "database_id": "0403b0c1-50c5-4467-85f2-149d41e63581"
    }
  ]
}
