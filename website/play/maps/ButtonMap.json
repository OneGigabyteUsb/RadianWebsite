  "scripts": [
    {
      "name": "ButtonA_Script",
      "scriptString": "const button = context.findInstance('ButtonA'); const door = context.findInstance('Door1'); if (!button || !door) return; const isPressed = context.isPlayerTouching(button); if (isPressed && !button._wasPressed) { door.CanCollide = false; door.Transparency = 0.3; } button._wasPressed = isPressed;"
